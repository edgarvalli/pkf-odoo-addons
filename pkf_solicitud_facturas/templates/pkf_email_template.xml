<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- TEMPLATE: SOLICITUD DE FACTURA REGISTRADA                 -->
    <!-- Destinatarios: Grupo de Facturación                       -->
    <!-- Servicio: NotifyRequestedService                          -->
    <!-- ========================================================= -->
    <record id="pkf_email_template_requested" model="mail.template">
        <field name="name">PKF - Solicitud de Factura Registrada</field>
        <field name="model_id" ref="pkf_solicitud_facturas.model_pkf_solicitud_factura" />
        <field name="subject">[PKF] Nueva solicitud de factura - Folio {{ object.folio }}</field>

        <field name="body_html" type="html">
            <div
                style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #333333; line-height: 1.5;">

                <!-- Encabezado -->
                <div style="background-color: #004080; padding: 18px 20px; color: #ffffff;">
                    <h2 style="margin: 0; font-size: 21px; color: #ffffff;">
                        Nueva solicitud de factura
                    </h2>
                    <p style="margin: 5px 0 0; color: #ffffff;"> Folio: <strong>
                            <t t-out="ctx.get('folio', '')" />
                        </strong>
                    </p>
                </div>

                <div style="padding: 20px; border: 1px solid #dddddd; border-top: none;">

                    <p>Estimado equipo de Facturación:</p>

                    <p>
                        Se ha registrado una nueva solicitud de factura.
                        A continuación, se muestran los datos para su revisión.
                    </p>

                    <!-- Datos generales -->
                    <h3 style="color: #004080; margin: 22px 0 10px;">
                        Datos de la solicitud
                    </h3>

                    <table style="border-collapse: collapse; width: 100%; margin: 10px 0 20px;">
                        <tbody>
                            <tr style="background-color: #f4f6f8;">
                                <td style="padding: 10px; border: 1px solid #dddddd; width: 32%;">
                                    <strong>Folio</strong>
                                </td>
                                <td style="padding: 10px; border: 1px solid #dddddd;">
                                    <t t-out="ctx.get('folio', '')" />
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; border: 1px solid #dddddd;">
                                    <strong>Cliente</strong>
                                </td>
                                <td style="padding: 10px; border: 1px solid #dddddd;">
                                    <t t-out="ctx.get('cliente', '')" />
                                </td>
                            </tr>
                            <tr style="background-color: #f4f6f8;">
                                <td style="padding: 10px; border: 1px solid #dddddd;">
                                    <strong>Método de pago</strong>
                                </td>
                                <td style="padding: 10px; border: 1px solid #dddddd;">
                                    <t t-out="ctx.get('metodo_pago', '')" />
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; border: 1px solid #dddddd;">
                                    <strong>Responsable</strong>
                                </td>
                                <td style="padding: 10px; border: 1px solid #dddddd;">
                                    <t t-out="ctx.get('responsable', '')" />
                                </td>
                            </tr>
                            <tr style="background-color: #f4f6f8;">
                                <td style="padding: 10px; border: 1px solid #dddddd;">
                                    <strong>Correos de envío</strong>
                                </td>
                                <td style="padding: 10px; border: 1px solid #dddddd;">
                                    <t t-out="ctx.get('correos', '')" />
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Partidas -->
                    <h3 style="color: #004080; margin: 22px 0 10px;">
                        Detalle de partidas
                    </h3>

                    <table style="border-collapse: collapse; width: 100%; margin: 10px 0;">
                        <thead>
                            <tr style="background-color: #004080; color: #ffffff;">
                                <th
                                    style="padding: 10px; border: 1px solid #dddddd; text-align: left; color: #ffffff;">
                                    Concepto
                                </th>
                                <th
                                    style="padding: 10px; border: 1px solid #dddddd; text-align: left; color: #ffffff;">
                                    Referencia
                                </th>
                                <th
                                    style="padding: 10px; border: 1px solid #dddddd; text-align: right; color: #ffffff;">
                                    Importe
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="ctx.get('partidas')">
                                <t t-foreach="ctx.get('partidas', [])" t-as="line">
                                    <tr>
                                        <td
                                            style="padding: 10px; border: 1px solid #dddddd; white-space: pre-wrap;">
                                            <t t-out="line.get('concepto', '')" />
                                        </td>
                                        <td style="padding: 10px; border: 1px solid #dddddd;">
                                            <t t-out="line.get('referencia', '-') or '-'" />
                                        </td>
                                        <td
                                            style="padding: 10px; border: 1px solid #dddddd; text-align: right; white-space: nowrap;">
                                            <t t-out="line.get('importe', '0.00')" />
                                        </td>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td colspan="3"
                                        style="padding: 12px; border: 1px solid #dddddd; text-align: center; color: #777777;">
                                        No se registraron partidas.
                                    </td>
                                </tr>
                            </t>

                            <tr style="background-color: #e8edf3;">
                                <td colspan="2"
                                    style="padding: 12px 10px; border: 1px solid #dddddd; text-align: right;">
                                    <strong>Total sin IVA</strong>
                                </td>
                                <td
                                    style="padding: 12px 10px; border: 1px solid #dddddd; text-align: right; white-space: nowrap;">
                                    <strong>
                                        <t t-out="ctx.get('total', '')" />
                                    </strong>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <p>
                        <strong>Acción requerida:</strong> revise la solicitud en Odoo y continúe
                        con el proceso de facturación. </p>

                    <p
                        style="margin-top: 24px; color: #777777; font-size: 12px; border-top: 1px solid #dddddd; padding-top: 12px;">
                        Este es un mensaje automático generado por el sistema PKF.
                        Por favor, no responda directamente a este correo.
                    </p>

                </div>
            </div>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- TEMPLATE: FACTURA CREADA                                  -->
    <!-- Destinatario: Responsable de la solicitud                 -->
    <!-- Servicio: NotifyCreatedService                            -->
    <!-- ========================================================= -->
    <record id="pkf_email_template_created" model="mail.template">
        <field name="name">PKF - Factura Creada</field>
        <field name="model_id" ref="pkf_solicitud_facturas.model_pkf_solicitud_factura" />
        <field name="subject">[PKF] Factura disponible - Folio {{ object.folio }}</field>

        <field name="body_html" type="html">
            <div
                style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #333333; line-height: 1.5;">

                <div style="background-color: #004080; color: #ffffff; padding: 18px 20px;">
                    <h2 style="margin: 0; font-size: 21px; color: #ffffff;">
                        Factura creada
                    </h2>
                    <p style="margin: 5px 0 0; color: #ffffff;"> Folio: <strong>
                            <t t-out="ctx.get('folio') or object.folio or ''" />
                        </strong>
                    </p>
                </div>

                <div style="padding: 20px; border: 1px solid #dddddd; border-top: none;">

                    <p> Estimado(a) <strong>
                            <t t-out="ctx.get('responsable') or 'colaborador'" />
                        </strong>
                        : </p>

                    <p>
                        Le informamos que la factura correspondiente a su solicitud
                        ha sido creada. Se adjuntan los archivos PDF y XML para su consulta.
                    </p>

                    <table style="border-collapse: collapse; width: 100%; margin: 18px 0;">
                        <tbody>
                            <tr style="background-color: #f4f6f8;">
                                <td style="padding: 10px; border: 1px solid #dddddd; width: 32%;">
                                    <strong>Folio de solicitud</strong>
                                </td>
                                <td style="padding: 10px; border: 1px solid #dddddd;">
                                    <t t-out="ctx.get('folio') or object.folio or ''" />
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; border: 1px solid #dddddd;">
                                    <strong>Cliente</strong>
                                </td>
                                <td style="padding: 10px; border: 1px solid #dddddd;">
                                    <t t-out="ctx.get('cliente') or ''" />
                                </td>
                            </tr>
                            <tr style="background-color: #f4f6f8;">
                                <td style="padding: 10px; border: 1px solid #dddddd;">
                                    <strong>Total sin IVA</strong>
                                </td>
                                <td style="padding: 10px; border: 1px solid #dddddd;">
                                    <strong>
                                        <t t-out="ctx.get('Total') or ''" />
                                    </strong>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; border: 1px solid #dddddd;">
                                    <strong>Método de pago</strong>
                                </td>
                                <td style="padding: 10px; border: 1px solid #dddddd;">
                                    <t t-out="ctx.get('metodo_pago') or ''" />
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div
                        style="background-color: #eef7ee; border: 1px solid #c8e6c9; padding: 12px 15px; margin: 18px 0;">
                        <strong style="color: #256029;">Documentos adjuntos</strong>
                        <ul style="margin: 8px 0 0; padding-left: 22px;">
                            <li>Factura en formato PDF</li>
                            <li>Factura en formato XML</li>
                        </ul>
                    </div>

                    <p>
                        Si tiene alguna duda respecto a la factura, comuníquese con el equipo de
                        Facturación.
                    </p>

                    <p
                        style="margin-top: 24px; color: #777777; font-size: 12px; border-top: 1px solid #dddddd; padding-top: 12px;">
                        Este es un mensaje automático generado por el sistema PKF.
                        Por favor, no responda directamente a este correo.
                    </p>

                </div>
            </div>
        </field>
    </record>

</odoo>