<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_inherit_pkf_sf" model="ir.ui.view">
        <field name="name">sale.order.inherit.pkf.sf</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    type="object"
                    string="Solicitar Factura"
                    invisible="state != 'sale' or pkf_solicitud_factura_id"
                    name="crear_solicitud_factura"
                    class="oe_highlight" />
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="replace">
                <field name="currency_id" readonly="state == 'sale'" />
            </xpath>
            <xpath expr="//group[@name='partner_details']" position="inside">
                <field name="pkf_solicitud_factura_id" readonly="True" invisible="state != 'sale'" />
            </xpath>
        </field>
    </record>

</odoo>