<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="envio_pago_template" model="mail.template">
        <field name="name">Correo de envio de Complementos de Pago PKF</field>
        <field name="model_id" ref="base.model_res_users" />
        <field name="auto_delete" eval="True" />
        <field name="subject">[INV] REP 4.0 {{ctx.get('subject', '')}}</field>
        <field name="body_html" type="html">
            <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#333;">
                <t t-set="msg"
                    t-value="'le hacemos llegar sus complementos de pago.' if len(ctx.get('documentos', [])) > 1 else 'le hacemos llegar su complemento de pago.'" />
                <br />
                <p>Estimado <strong>
                        <t t-out="ctx.get('razon_social','')" />
                    </strong></p>
                <p> Por este medio <![CDATA[&nbsp;]]>
                    <t t-out="msg" />
                </p>

            </div>
        </field>
    </record>

</odoo>