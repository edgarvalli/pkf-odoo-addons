<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="cron_send_estado_cuenta_clientes" model="ir.cron">
            <field name="name">PKF - Estado de cuenta Clientes</field>
            <field name="model_id" ref="model_pkf_clientes" />
            <field name="state">code</field>
            <field name="code">model.enviar_estado_cuenta_bulk()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True" />
        </record>

        <record id="cron_sync_clientes_y_grupos_comercial" model="ir.cron">
            <field name="name">PKF - Sincronizador de clientes y grupos comercial</field>
            <field name="model_id" ref="model_pkf_clientes" />
            <field name="state">code</field>
            <field name="code">model.sync_clientes()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False" />
        </record>

    </data>
</odoo>