<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pkf_timesheet_project_view_form" model="ir.ui.view">
        <field name="name">pkf.timesheet.project.view.form</field>
        <field name="model">pkf.timesheet.project</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Barra de estado interactiva -->
                    <field name="state" widget="statusbar" options="{'fold_field': 'fold'}"
                        statusbar_visible="draft,in_progress,done" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_project_expenses"
                            type="object"
                            icon="fa-dollar-sign"
                            class="oe_stat_button"
                        >
                            <field name="expense_count" widget="statinfo" string="Gastos" />
                        </button>
                        <button
                            name="action_view_hours"
                            type="object"
                            icon="fa-clock"
                            class="oe_stat_button"
                        >
                            <field name="hours_spend_count" widget="statinfo" string="Horas" />
                        </button>
                    </div>

                    <widget name="web_ribbon" title="En progreso" bg_color="text-bg-secondary"
                        invisible="state != 'in_progress'" />

                    <widget name="web_ribbon" title="Finalizado" bg_color="text-bg-success"
                        invisible="state != 'done'" />

                    <widget name="web_ribbon" title="Cancelado" bg_color="text-bg-danger"
                        invisible="state != 'cancelled'" />

                    <div class="oe_title">
                        <h1>
                            <field name="code" readonly="1" class="oe_inline" /> - <field
                                name="name" placeholder="Nombre del Proyecto..." />
                        </h1>
                    </div>

                    <group>
                        <group string="Información de Proyecto">
                            <field name="client_id" />
                            <field name="cancellation_porcentage" widget="float" />
                            <field name="state" string="Estatus" />
                        </group>
                        <group string="Responsables">
                            <field name="manager_id" widget="many2one_avatar_user" />
                            <field name="director_id" widget="many2one_avatar_user"
                                string="Socio/Director" />
                        </group>
                    </group>

                    <notebook>
                        <page name="users" string="Equipo Asignado">
                            <field name="assigned_user_ids">
                                <list editable="top">
                                    <field name="image_128" widget="image"
                                        options="{'size': [24, 24]}" class="o_avatar rounded"
                                        nolabel="1" />
                                    <field name="name" />
                                    <field name="work_email" />
                                    <field name="department_id" />
                                    <field name="job_id" />
                                    <!-- Asegúrate que este campo exista en hr.employee o usa
                                    timesheet_cost -->
                                    <field name="timesheet_cost" sum="Total Costo Hora" />
                                </list>
                            </field>
                        </page>

                        <page name="phases" string="Fases">
                            <field name="phase_ids">
                                <list editable="top">
                                    <field name="name" />
                                    <!-- Agrega aquí más campos de tus fases si existen -->
                                </list>
                            </field>
                        </page>

                        <page name="financials" string="Análisis de Costos">
                            <group>
                                <group string="Presupuesto">
                                    <field name="total_budget_amount" widget="monetary" />
                                </group>
                                <group string="Resumen de Gastos">
                                    <field name="total_expenses_amount" widget="monetary" />
                                    <field name="total_timesheet_cost_amount" widget="monetary" />
                                    <field name="total_amount_spend" widget="monetary"
                                        decoration-danger="total_amount_spend &lt; 0" />
                                </group>
                            </group>
                        </page>

                        <page name="description" string="Descripción">
                            <field name="note"
                                placeholder="Notas internas o descripción del proyecto..." />
                        </page>
                    </notebook>
                </sheet>
                <!-- Sección de Chatter para historial y actividades -->
                <chatter />
            </form>
        </field>
    </record>

    <record id="pkf_timesheet_project_view_list" model="ir.ui.view">
        <field name="name">pkf.timesheet.project.view.list</field>
        <field name="model">pkf.timesheet.project</field>
        <field name="arch" type="xml">
            <list string="Proyectos">
                <field name="code" />
                <field name="name" />
                <field name="client_id" />
                <field name="manager_id" widget="many2one_avatar_user" />
                <field name="total_budget_amount" sum="Total Presupuestos" />
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'in_progress'"
                    decoration-success="state == 'done'"
                    decoration-danger="state == 'cancelled'" />
            </list>
        </field>
    </record>

    <!-- Vista Kanban -->
    <record id="pkf_timesheet_project_view_kanban" model="ir.ui.view">
        <field name="name">pkf.timesheet.project.view.kanban</field>
        <field name="model">pkf.timesheet.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_project_tasks" quick_create="false">
                <field name="state" />
                <field name="name" />
                <field name="client_id" />
                <field name="manager_id" />
                <field name="total_budget_amount" />
                <field name="total_amount_spend" />
                <field name="code" />
                <templates>
                    <t t-name="card"> <!-- En Odoo 17+ 'card' es el nuevo estándar, pero 'kanban-box'
                        suele mantenerse por compatibilidad -->
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="oe_kanban_details d-flex flex-column">
                                <t t-name="kanban-box">
                                    <div
                                        t-attf-class="oe_kanban_global_click o_kanban_record_has_image_fill">
                                        <div class="oe_kanban_details d-flex flex-column">
                                            <div class="o_kanban_record_top">
                                                <div class="o_kanban_record_headings">
                                                    <strong class="o_kanban_record_title">
                                                        <field name="code" /> - <field name="name" />
                                                    </strong>
                                                    <span class="d-block text-muted">
                                                        <i class="fa fa-user" title="Cliente" />
                                                        <field name="client_id" />
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="o_kanban_record_body mt-2">
                                                <!-- Barra de progreso visual del presupuesto -->
                                                <t t-set="budget_reached"
                                                    t-value="record.total_budget_amount.raw_value > 0 and (record.total_amount_spend.raw_value / record.total_budget_amount.raw_value) * 100 or 0" />
                                                <div class="progress" style="height: 8px;"
                                                    title="Presupuesto consumido">
                                                    <div
                                                        t-attf-class="progress-bar #{budget_reached > 90 ? 'bg-success' : (budget_reached > 70 ? 'bg-warning' : 'bg-danger')}"
                                                        role="progressbar"
                                                        t-att-style="'width: ' + (budget_reached > 100 ? 100 : budget_reached) + '%;'" />
                                                </div>
                                                <div class="d-flex justify-content-between mt-1"
                                                    style="font-size: 0.8rem;">
                                                    <span>Gasto: <field name="total_amount_spend"
                                                            widget="monetary" /></span>
                                                    <span>Presupuesto: <field
                                                            name="total_budget_amount"
                                                            widget="monetary" /></span>
                                                </div>
                                            </div>

                                            <div
                                                class="o_kanban_record_bottom mt-auto d-flex justify-content-between align-items-center">
                                                <div class="oe_kanban_bottom_left">
                                                    <field name="state" widget="label_selection"
                                                        options="{'classes': {'draft': 'default', 'in_progress': 'info', 'done': 'success', 'cancelled': 'danger'}}" />
                                                </div>
                                                <div class="oe_kanban_bottom_right">
                                                    <field name="manager_id"
                                                        widget="many2one_avatar_user" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>