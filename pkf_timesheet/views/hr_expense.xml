<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="form_hr_expense_inherit_pkf" model="ir.ui.view">
        <field name="name">form.hr.expense.inherit.pkf</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="pfk_timesheet_project_id" widget="many2one_avatar_user"
                    readonly="state in ['posted','in_payment','paid','refused']"
                    placeholder="Auto-validation" />
            </xpath>
        </field>
    </record>

</odoo>