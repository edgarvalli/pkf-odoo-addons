<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pkf_project_import_form" model="ir.ui.view">
        <field name="name">pkf.project.import.form</field>
        <field name="model">pkf.timesheet.project.import</field>
        <field name="arch" type="xml">
            <form string="Subir proyectos masivamente">
                <sheet>
                    <group>
                        <field name="file" string="Subir archivo" />
                    </group>
                    <group>
                        <button
                            string="Descargar plantilla"
                            type="action"
                            name="%(action_download_projectos_template)d"
                            icon="fa-external-link"
                            class="btn-link" />
                    </group>
                    <footer>
                        <button
                            string="Procesar"
                            type="object"
                            name="import_template"
                            class="btn-primary" />
                        <button
                            string="Cancelar"
                            special="cancel" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

</odoo>