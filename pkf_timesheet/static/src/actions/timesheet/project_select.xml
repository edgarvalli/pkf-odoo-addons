<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">
    <t t-name="pkf_timesheet.ProjectSelect">
        <div>
          <label class="text-muted small fw-bold">Selecciona un proyecto</label>
          <div class="ev-select" t-att-class="{'open': state.isOpen}">
              <input
                type="text"
                t-att-value="state.value"
                t-on-focus="toggleMenu.bind(this, true)"
                t-on-blur="toggleMenu.bind(this, false)"
                t-on-keyup="onChange.bind(this)"
              />
              <ul >
                <t t-foreach="state.options" t-as="option" t-key="option_index">
                  <li
                    t-out="option.label"
                    t-on-mousedown.prevent="onProjectSelect.bind(this, option)"
                  />
                </t>
              </ul>
          </div>
      </div>
    </t>
</templates>