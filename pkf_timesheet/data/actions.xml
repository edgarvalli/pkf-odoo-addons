<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_pkf_ts_dashboard" model="ir.actions.client">
        <field name="name">PKF - Registro de Tiempos</field>
        <field name="tag">pkf_timesheet.Timesheet</field>
        <field name="target">main</field>
    </record>

    <record id="pkf_timesheet_project_action" model="ir.actions.act_window">
        <field name="name">PKF - Proyectos</field>
        <field name="res_model">pkf.timesheet.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <div>
                <h1>Proyectos</h1>
            </div>
        </field>
    </record>

    <record id="pkf_timesheet_phase_action" model="ir.actions.act_window">
        <field name="name">PKF - Fases</field>
        <field name="res_model">pkf.timesheet.project.phase</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <div>
                <h1>Fases del proyecto</h1>
            </div>
        </field>
    </record>

    <record id="pkf_timesheet_task_action" model="ir.actions.act_window">
        <field name="name">PKF - Tareas</field>
        <field name="res_model">pkf.timesheet.project.task</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="search_view_id" ref="pkf_timesheet_project_task_view_search" />
        <field name="context">{
            'search_default_group_by_phase': 1
            }</field>
        <field name="help" type="html">
            <div>
                <h1>Tareas del pryecto</h1>
            </div>
        </field>
    </record>

</odoo>