<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pkf_timesheet_pdate_period_date" model="ir.cron">
        <field name="name">PKF - Control de Tiempos Actualizar Periodos</field>
        <field name="model_id" ref="model_pkf_timesheet_project_cron_service" />
        <field name="state">code</field>
        <field name="code">model.cron_process()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall"
            eval="(datetime.now() + timedelta(days=1)).replace(hour=3, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')" />
    </record>

</odoo>