<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mail_template_contribuyentes_sincronizacion" model="mail.template">
            <field name="name">SAT - Resultado de sincronización</field>
            <field name="model_id" ref="base.model_res_users" />
            <field name="subject">Sincronización de lista de contribuyentes SAT completada</field>

            <field name="body_html" type="html">
                <div style="margin: 0; padding: 0; font-family: Arial, sans-serif; color: #333333;">
                    <div style="background-color: #0a2555; padding: 20px; color: #ffffff;">
                        <h2 style="margin: 0; color: #ffffff;">
                            Sincronización de contribuyentes SAT
                        </h2>
                    </div>

                    <div style="padding: 24px;">
                        <p>Hola equipo,</p>

                        <p>
                            La sincronización del listado de contribuyentes del SAT
                            ha finalizado correctamente.
                        </p>

                        <table style="width: 100%; border-collapse: collapse; margin: 20px 0;">
                            <thead>
                                <tr style="background-color: #f2f4f8;">
                                    <th
                                        style="padding: 12px; border: 1px solid #dddddd; text-align: left;">
                                        Resultado
                                    </th>
                                    <th
                                        style="padding: 12px; border: 1px solid #dddddd; text-align: right;">
                                        Registros
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="padding: 12px; border: 1px solid #dddddd;">
                                        Contribuyentes creados
                                    </td>
                                    <td
                                        style="padding: 12px; border: 1px solid #dddddd; text-align: right; color: #198754; font-weight: bold;">
                                        <t t-out="ctx.get('created', 0)" />
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 12px; border: 1px solid #dddddd;">
                                        Contribuyentes actualizados
                                    </td>
                                    <td
                                        style="padding: 12px; border: 1px solid #dddddd; text-align: right; color: #0d6efd; font-weight: bold;">
                                        <t t-out="ctx.get('updated', 0)" />
                                    </td>
                                </tr>
                                <tr style="background-color: #f8f9fa;">
                                    <td
                                        style="padding: 12px; border: 1px solid #dddddd; font-weight: bold;">
                                        Total procesado
                                    </td>
                                    <td
                                        style="padding: 12px; border: 1px solid #dddddd; text-align: right; font-weight: bold;">
                                        <t t-out="ctx.get('created', 0) + ctx.get('updated', 0)" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <p> Puedes consultar los registros en el módulo <strong>Contribuyentes SAT</strong>
                            . </p>

                        <p style="margin-top: 28px;"> Saludos,<br />
                            <strong>Equipo de Sistemas PKF</strong>
                        </p>
                    </div>

                    <div
                        style="background-color: #f2f4f8; padding: 12px 24px; font-size: 12px; color: #666666;">
                        Este correo fue generado automáticamente. Por favor, no respondas a este
                        mensaje.
                    </div>
                </div>
            </field>
        </record>

    </data>
</odoo>