<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Listado de grupos -->
    <record id="view_pkf_contribuyente_group_list" model="ir.ui.view">
        <field name="name">pkf.contribuyente.group.list</field>
        <field name="model">pkf.contribuyente.group</field>
        <field name="arch" type="xml">
            <list string="Grupos de contribuyentes">
                <field name="name" />
                <field name="owner_ids" />
                <field name="member_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <!-- Formulario del grupo -->
    <record id="view_pkf_contribuyente_group_form" model="ir.ui.view">
        <field name="name">pkf.contribuyente.group.form</field>
        <field name="model">pkf.contribuyente.group</field>
        <field name="arch" type="xml">
            <form string="Grupo de contribuyentes">
                <field name="is_member" invisible="1" />

                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name"
                                placeholder="Nombre del grupo"
                                readonly="is_member" />
                        </h1>
                    </div>

                    <group>
                        <field name="member_ids"
                            widget="many2many_tags"
                            readonly="is_member" />
                    </group>

                    <notebook>
                        <page string="Contribuyentes">
                            <field name="contribuyente_ids"
                                nolabel="1"
                                readonly="is_member">
                                <list default_order="rfc asc"
                                    decoration-warning="situacion == 'presunto'"
                                    decoration-danger="situacion == 'definitivo'"
                                    decoration-success="situacion == 'sentencia_favorable'">
                                    <field name="rfc" />
                                    <field name="nombre" />
                                    <field name="situacion" widget="badge" />
                                </list>
                            </field>
                        </page>

                        <page string="Miembros">
                            <field name="member_ids" readonly="is_member">
                                <list>
                                    <field name="name" />
                                    <field name="email" />
                                    <field name="phone" />
                                </list>
                            </field>
                        </page>

                        <page string="Propietarios">
                            <field name="owner_ids" readonly="is_member">
                                <list>
                                    <field name="name" />
                                    <field name="email" />
                                    <field name="phone" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>