<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pkf_contribuyentes_action" model="ir.actions.act_window">
        <field name="name">Contribuyentes SAT</field>
        <field name="res_model">pkf.contribuyente</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pkf_contribuyente_search" />
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay contribuyentes registrados.
            </p>
            <p>
                Los contribuyentes importados desde los listados del SAT
                aparecerán aquí.
            </p>
        </field>
    </record>

    <record id="action_pkf_contribuyente_group" model="ir.actions.act_window">
        <field name="name">Grupos de contribuyentes</field>
        <field name="res_model">pkf.contribuyente.group</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>